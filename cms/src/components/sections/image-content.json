{
  "collectionName": "components_sections_image_contents",
  "info": {
    "displayName": "Image + Content"
  },
  "options": {},
  "attributes": {
    "isVisible": {
      "type": "boolean",
      "default": true
    },
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "imageUrl": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-link"
    },
    "imagePosition": {
      "type": "enumeration",
      "enum": ["left", "right"],
      "default": "right"
    }
  }
}
