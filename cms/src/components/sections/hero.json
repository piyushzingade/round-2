{
  "collectionName": "components_sections_heroes",
  "info": {
    "displayName": "Hero",
    "description": "Primary landing page hero with approved layout variants."
  },
  "options": {},
  "attributes": {
    "variant": {
      "type": "enumeration",
      "enum": ["centered", "split", "product", "minimal"],
      "default": "split",
      "required": true
    },
    "isVisible": {
      "type": "boolean",
      "default": true
    },
    "eyebrow": {
      "type": "string"
    },
    "headline": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "primaryCTA": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-link"
    },
    "secondaryCTA": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-link"
    },
    "imageUrl": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "imageAlt": {
      "type": "string"
    },
    "imageCaption": {
      "type": "string"
    },
    "trustItems": {
      "type": "json"
    }
  }
}
