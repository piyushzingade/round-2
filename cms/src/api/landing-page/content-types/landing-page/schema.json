{
  "kind": "collectionType",
  "collectionName": "landing_pages",
  "info": {
    "singularName": "landing-page",
    "pluralName": "landing-pages",
    "displayName": "Landing Page",
    "description": "CMS-authored marketing landing pages rendered by the Next.js frontend."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.navbar",
        "sections.hero",
        "sections.feature-grid",
        "sections.stats",
        "sections.testimonial",
        "sections.cta",
        "sections.footer"
      ]
    }
  }
}
